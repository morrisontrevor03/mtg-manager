# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite db (the schema is Postgres now; these are leftovers)
/prisma/*.db
/prisma/*.db-journal
/prisma/_sqlite-migrations.bak

# lambda deployment package (rebuild with `npm run lambda:build`)
/lambda/dist

# terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/crash.log
# holds api_shared_secret and anthropic_api_key
infra/terraform.tfvars
# saved plans embed variable values, secrets included
infra/*.tfplan
infra/tfplan.bin

# static frontend build output (rebuild with `npm run build:static`)
/out

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local copy of the deployed Cognito config (npm run auth:config)
/public/auth-config.json
