# Copy to .env and fill in.

# Postgres connection string. The schema's datasource is `postgresql`.
#
# Local development — start a throwaway Postgres with Docker:
#   docker run --name mtg-pg -e POSTGRES_PASSWORD=mtg -e POSTGRES_DB=mtg \
#     -p 5432:5432 -d postgres:16
#   npx prisma migrate deploy
DATABASE_URL="postgresql://postgres:mtg@localhost:5432/mtg"

# Deployed backend — fetch the managed connection string instead:
#   cd infra && terraform output -raw database_url_command
# RDS is private to the VPC, so that URL only resolves from inside it.

# Anthropic API key for the LLM deck builder. https://console.anthropic.com/
# Note: the deck builder ships disabled in the AWS deployment — see infra/README.md.
ANTHROPIC_API_KEY=""
# Only for a key not scoped to a workspace: the workspace id (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=""

# Descriptive User-Agent sent to the Scryfall API (they request one).
SCRYFALL_UA="MTGManager/0.1 (you@example.com)"
